@page "/internet"

@inject JugadorServicio JugadorService
@inject JugadorState JugadorState
@inject ComercioServicio ComercioServicio
@inject NavigationManager navigationManager

<div class="internet-container">
    <div class="main-section">

        <div class="sidebar">

            <button class="nav-btn @(!mostrarIntercambio ? "active" : "")"
                    @onclick="MostrarPrincipal">
                Convertir
            </button>

            <button class="nav-btn @(mostrarIntercambio ? "active" : "")"
                    @onclick="MostrarIntercambio">
                Intercambiar
            </button>

            <button class="nav-btn" @onclick="AbrirConfiguracion">
                ⚙️ Configuración
            </button>

        </div>

        <div class="content-area">

            <div style="background-color:#f1f8ff; color:#000; padding:10px; border-radius:5px; margin-bottom:20px; border:2px solid #404040;">
                <strong>Tus saldos:</strong>
                🪙 @saldoPoints Points |
                💰 @saldoPPCoins.ToString("N0") PP Coins

                <hr />

                <strong>Límite global de PP Coins:</strong>
                @LimiteGlobalPPCoins.ToString("N0")
            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <p class="@claseMensaje">@mensaje</p>
            }

            @if (!mostrarIntercambio)
            {
                <div class="convertir-view">

                    <h2>Convertir Points a PP Coins</h2>

                    <div class="form-group">
                        <label>Points a convertir:</label>

                        <input type="number"
                               @bind="PuntosAConvertir"
                               @bind:event="oninput"
                               min="0"
                               max="@saldoPoints"
                               disabled="@ocupado" />
                    </div>

                    <div class="form-group">
                        <label>Equivalente en PP Coins:</label>

                        <input type="text"
                               disabled
                               value="@EquivalentePPCoints" />
                    </div>

                    <p>
                        Tasa de conversión:
                        10 Points = 1 PP Coin
                    </p>

                    <button class="action-btn"
                            disabled="@(!PuedeConvertir)"
                            @onclick="ConfirmarConversionAsync">

                        @(ocupado
                            ? "Procesando..."
                            : "Confirmar Conversión")

                    </button>

                    <div style="margin-top:30px;border-top:2px solid #eee;padding-top:15px;">

                        <h3>Últimas conversiones</h3>

                        @if (historialConversiones.Count == 0)
                        {
                            <p>No hay conversiones recientes.</p>
                        }
                        else
                        {
                            <ul class="item-list">
                                @foreach (var conv in historialConversiones)
                                {
                                    <li>⏱️ @conv</li>
                                }
                            </ul>
                        }

                    </div>
                </div>
            }
            else
            {
                <div class="intercambiar-view">

                    <h2>Mercado de Intercambio</h2>

                    <p>
                        Accedé al mercado para ver los intercambios disponibles.
                    </p>

                    <button class="action-btn" @onclick="IrAIntercambios">
                        🛒 Abrir mercado
                    </button>

                    <button class="action-btn" @onclick="MostrarPrincipal">
                        ← Volver
                    </button>

                </div>
            }

        </div>
    </div>
</div>

<ConfiguracionModal @bind-Mostrar="mostrarModalConfig" />

@code {

    private bool mostrarIntercambio = false;

    private int idJugador;

    private bool ocupado;

    private string? mensaje;

    private string claseMensaje = "mensaje-exito";

    private int _puntosAConvertir;

    private List<string> historialConversiones = new();

    private const int TasaDeCambio = 10;

    private const double LimiteGlobalPPCoins = 500000;

    private int saldoPoints;

    private double saldoPPCoins;

    private bool mostrarModalConfig = false;

    public int PuntosAConvertir
    {
        get => _puntosAConvertir;
        set => _puntosAConvertir = value;
    }

    public int EquivalentePPCoints =>
        PuntosAConvertir > 0
            ? PuntosAConvertir / TasaDeCambio
            : 0;

    private bool PuedeConvertir =>
        !ocupado &&
        JugadorState.__jugador != null &&
        PuntosAConvertir > 0 &&
        PuntosAConvertir <= saldoPoints &&
        PuntosAConvertir % TasaDeCambio == 0;

    protected override void OnInitialized()
    {
        if (JugadorState.__jugador == null)
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        idJugador = JugadorState.__jugador.Id;

        ActualizarSaldo();
    }

    private void ActualizarSaldo()
    {
        if (JugadorState.__jugador == null)
            return;

        saldoPoints = JugadorState.__jugador.points;
        saldoPPCoins = JugadorState.__jugador.ppCoins;
    }

    private void MostrarPrincipal()
    {
        if (ocupado)
            return;

        mostrarIntercambio = false;
        PuntosAConvertir = 0;
        mensaje = null;
    }

    private void MostrarIntercambio()
    {
        if (ocupado)
            return;

        mostrarIntercambio = true;
        PuntosAConvertir = 0;
        mensaje = null;
    }

    private void IrAIntercambios()
    {
        navigationManager.NavigateTo("/intercambios");
    }

    private void AbrirConfiguracion()
    {
        mostrarModalConfig = true;
    }

    private async Task ConfirmarConversionAsync()
    {
        if (ocupado)
            return;

        var jugador = JugadorState.__jugador;

        if (jugador == null)
        {
            mensaje = "No hay un jugador conectado.";
            claseMensaje = "mensaje-error";
            return;
        }

        int puntosSolicitados = PuntosAConvertir;

        if (puntosSolicitados <= 0)
        {
            mensaje = "Ingresá una cantidad válida de Points.";
            claseMensaje = "mensaje-error";
            return;
        }

        if (puntosSolicitados > saldoPoints)
        {
            mensaje = "No tenés suficientes Points.";
            claseMensaje = "mensaje-error";
            return;
        }

        if (puntosSolicitados % TasaDeCambio != 0)
        {
            mensaje = "La cantidad debe ser múltiplo de 10 Points.";
            claseMensaje = "mensaje-error";
            return;
        }

        ocupado = true;
        mensaje = null;

        int coinsEsperados = puntosSolicitados / TasaDeCambio;

        try
        {
            // Única ruta de conversión:
            // POST api/Conversor/convertir
            var respuesta = await ComercioServicio.ConvertirPoints(
                idJugador,
                puntosSolicitados);

            if (!respuesta.Exito)
            {
                mensaje = respuesta.Mensaje;
                claseMensaje = "mensaje-error";
                return;
            }

            // La conversión ya fue aceptada por el servidor.
            // Consultamos nuevamente los saldos reales.
            var jugadorActualizado =
                await JugadorService.ObtenerPorId(idJugador);

            if (jugadorActualizado == null)
            {
                mensaje =
                    "La conversión fue realizada, pero no se pudieron actualizar los saldos. No vuelvas a convertir hasta consultar tu saldo.";

                claseMensaje = "mensaje-error";
                return;
            }

            // Actualizamos los saldos locales con los valores del servidor.
            jugador.points = jugadorActualizado.points;
            jugador.ppCoins = jugadorActualizado.ppCoins;

            saldoPoints = jugadorActualizado.points;
            saldoPPCoins = jugadorActualizado.ppCoins;

            JugadorState.NotificarCambios();

            historialConversiones.Insert(
                0,
                $"-{puntosSolicitados} Points / +{coinsEsperados} PP Coins");

            PuntosAConvertir = 0;

            mensaje = respuesta.Mensaje;
            claseMensaje = "mensaje-exito";
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error al convertir Points: {ex}");

            mensaje =
                "No se pudo confirmar el resultado. Consultá tus saldos antes de intentar otra conversión.";

            claseMensaje = "mensaje-error";
        }
        finally
        {
            ocupado = false;
        }
    }
}
