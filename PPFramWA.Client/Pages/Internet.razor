@page "/internet"

@* Inyectamos los servicios *@
@inject JugadorServicio JugadorService
@inject JugadorState JugadorState
@inject ComercioServicio ComercioService

<div class="internet-container">
    <div class="main-section">

        <div class="sidebar">
            <button class="nav-btn @(!mostrarIntercambio ? "active" : "")"
                    @onclick="MostrarPrincipal">
                Convertir
            </button>
            <button class="nav-btn @(mostrarIntercambio ? "active" : "")"
                    @onclick="MostrarIntercambio">
                Intercambiar
            </button>
        </div>

        <div class="content-area">

            <!-- Indicador de saldos reales con protección contra nulos (?) -->
            <div style="background-color: #f1f8ff; padding: 10px; border-radius: 5px; margin-bottom: 20px;">
                <strong>Tus saldos:</strong> 🪙 @(JugadorState.__jugador?.points ?? 0) Points | 💰 @(JugadorState.__jugador?.ppCoins ?? 0) PP Coins
            </div>

            <!-- Mensajes del sistema -->
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <p class="@claseMensaje" style="padding: 10px; border-radius: 5px; margin-bottom: 15px; font-weight: bold;">
                    @mensaje
                </p>
            }

            @if (!mostrarIntercambio)
            {
                <div class="convertir-view">
                    <h2>Convertir Points a PP Coins</h2>

                    <div class="form-group">
                        <label>Points a convertir:</label>
                        <input type="number" @bind="PuntosAConvertir" @bind:event="oninput" placeholder="Ej: 1000" min="0" max="@(JugadorState.__jugador?.points ?? 0)" />
                    </div>
                    <div class="form-group">
                        <label>Equivalente en PP Coins:</label>
                        <input type="text" disabled value="@EquivalentePPCoints" />
                    </div>

                    <button class="action-btn"
                            disabled="@(ocupado || PuntosAConvertir <= 0 || PuntosAConvertir > (JugadorState.__jugador?.points ?? 0))"
                            @onclick="ConfirmarConversionAsync">
                        @(ocupado ? "Procesando..." : "Confirmar Conversión")
                    </button>

                    <div style="margin-top: 30px; border-top: 2px solid #eee; padding-top: 15px;">
                        <h3>Últimas conversiones</h3>
                        @if (historialConversiones.Count == 0)
                        {
                            <p style="color: #666;">No hay conversiones recientes.</p>
                        }
                        else
                        {
                            <ul class="item-list">
                                @foreach (var conv in historialConversiones)
                                {
                                    <li>⏱️ @conv</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="intercambiar-view">
                    <h2>Mercado de Intercambio</h2>
                    <ul class="item-list">
                        <li>⛏️ 1x Pico de Diamante</li>
                        <li>🪏 1x Pala de Bronce</li>
                        <li>🌙 1x Hoz Dorada</li>
                    </ul>
                    <button class="action-btn" @onclick="MostrarPrincipal">
                        ← Volver
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool mostrarIntercambio = false;
    private int idJugador = 2;
    private bool ocupado;
    private string? mensaje;
    private string claseMensaje = "mensaje-exito";
    private int _puntosAConvertir;
    private List<string> historialConversiones = new();
    private const decimal TasaDeCambio = 10m;

    // Declaramos estas variables para que no te tire error CS0103
    private int saldoPoints;
    private double saldoPPCoins;

    public int PuntosAConvertir
    {
        get => _puntosAConvertir;
        set => _puntosAConvertir = value;
    }

    public int EquivalentePPCoints => (int)(PuntosAConvertir / TasaDeCambio);

    protected override async Task OnInitializedAsync()
    {
        idJugador = JugadorState.__jugador?.Id > 0
            ? JugadorState.__jugador.Id
            : 2;

        await ActualizarSaldo();
    }

    // Faltaban estos dos métodos para los botones laterales
    private void MostrarPrincipal()
    {
        mostrarIntercambio = false;
    }

    private void MostrarIntercambio()
    {
        mostrarIntercambio = true;
    }

    private async Task ConfirmarConversionAsync()
    {
        ocupado = true;
        mensaje = null;

        try
        {
            var respuestaDelServidor = await ComercioService.ConvertirPoints(idJugador, PuntosAConvertir);

            mensaje = respuestaDelServidor.Mensaje;
            claseMensaje = respuestaDelServidor.Exito ? "mensaje-exito" : "mensaje-error";

            if (respuestaDelServidor.Exito && JugadorState.__jugador != null)
            {
                JugadorState.__jugador.points -= PuntosAConvertir;
                JugadorState.__jugador.ppCoins += EquivalentePPCoints;

                historialConversiones.Insert(0, $"-{PuntosAConvertir} Points / +{EquivalentePPCoints} PP Coins");
                PuntosAConvertir = 0;
            }
        }
        catch (Exception)
        {
            mensaje = "Ocurrió un error de conexión.";
            claseMensaje = "mensaje-error";
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task ActualizarSaldo()
    {
        if (JugadorState.__jugador != null)
        {
            // Actualizamos las dos monedas usando el estado
            saldoPoints = JugadorState.__jugador.points;
            saldoPPCoins = JugadorState.__jugador.ppCoins;

            // Avisamos a la página que los datos cambiaron para que se repinte
            JugadorState.NotificarCambios();
        }

        await Task.CompletedTask;
    }
}