@page "/login"
@using PPFarmWA.Shared.DTO
@inject NavigationManager Navigation
@inject HttpClient Http
@inject JugadorState jugadorState

<div class="pf-auth terrain-bg">
    <div class="pf-title">PP FARM</div>

    <div class="pf-frame">
        <!-- Acentos de esquina (formas del diseno original, paleta Terraria) -->
        <div class="pf-corner pf-corner-tl"></div>
        <div class="pf-corner pf-corner-tr"></div>
        <div class="pf-corner pf-corner-bl"></div>
        <div class="pf-corner pf-corner-br"></div>

        <form class="formulario pf-panel">

            <!-- CABECERA -->
            <header class="pf-cabecera">
                <div class="pf-pips">
                    <span class="pf-pip"></span>
                    <span class="pf-pip-sm"></span>
                </div>

                <h1>Iniciar Sesión</h1>

                <div class="pf-pips">
                    <span class="pf-pip-sm"></span>
                    <span class="pf-pip"></span>
                </div>
            </header>

            <!-- CUERPO DEL FORMULARIO -->
            <div class="pf-body">

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="pf-error" id="errorBox">
                        <span>⚠</span>
                        <span id="errorMessage">@mensajeError</span>
                    </div>
                }

                <div class="pf-field">
                    <label for="emailInput">
                        <span>📧</span>
                        <span>Correo electrónico</span>
                    </label>
                    <div class="pf-input">
                        <input id="emailInput"
                               type="email"
                               required
                               autocomplete="username"
                               placeholder="Correo electrónico"
                               @bind="login.Email" />
                    </div>
                </div>

                <div class="pf-field">
                    <label for="passwordInput">
                        <span>🔑</span>
                        <span>Contraseña</span>
                    </label>
                    <div class="pf-input">
                        <input id="passwordInput"
                               type="password"
                               required
                               autocomplete="current-password"
                               placeholder="Contraseña"
                               @bind="login.Password" />
                    </div>
                </div>

                <div class="pf-actions">
                    <button type="button"
                            class="boton-primario iniciar"
                            disabled="@cargando"
                            @onclick="IniciarSesion">
                        <span>🔓</span>
                        <span>@(cargando ? "Cargando..." : "Iniciar Sesión")</span>
                    </button>

                    <button type="button"
                            class="custom-btn crear"
                            @onclick="Registrar">
                        <span>👤</span>
                        <span>Crear Cuenta</span>
                    </button>
                </div>

            </div>

            <!-- PIE -->
            <footer class="pf-footer">
                <span class="pf-footer-right">PP-FARM-OS</span>
            </footer>

        </form>
    </div>
</div>

@code {
    private Login1DTO login = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;

    private void Registrar()
    {
        Navigation.NavigateTo("/register");
    }

    private async Task IniciarSesion()
    {
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            // 1. Enviamos Login1DTO (Email y Password) a la API
            var response = await Http.PostAsJsonAsync("api/jugador/loginmailpass", login);

            if (response.IsSuccessStatusCode)
            {

                // 2. Leemos el SesionDTO devuelto por la API
                var sesion = await response.Content.ReadFromJsonAsync<SesionDTO>();

                if (sesion != null)
                {
                    jugadorState.EstablecerJugador(sesion);

                    // 4. Redirigimos al Home (/)
                    Navigation.NavigateTo("/");
                    return;
                }

            }

            if (response.StatusCode == System.Net.HttpStatusCode.BadRequest ||
                response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                mensajeError = "Correo electrónico o contraseña incorrectos.";
            }
            else
            {
                mensajeError = "Ocurrió un error al procesar la solicitud. Intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }
}