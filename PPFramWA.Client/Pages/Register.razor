@page "/register"
@using System.Text.Json
@using PPFarmWA.Shared.DTO
@inject JugadorState JugadorState
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="pf-register">
    <div class="pf-auth terrain-bg">
        <div class="pf-title">PP FARM</div>

        <div class="pf-frame">
            <!-- Acentos de esquina (formas del diseno original, paleta Terraria) -->
            <div class="pf-corner pf-corner-tl"></div>
            <div class="pf-corner pf-corner-tr"></div>
            <div class="pf-corner pf-corner-bl"></div>
            <div class="pf-corner pf-corner-br"></div>

            <form class="pf-panel" @onsubmit="ProcesarRegistro" @onsubmit:preventDefault>

                <!-- CABECERA -->
                <header class="pf-cabecera">
                    <div class="pf-pips">
                        <span>👤</span>
                    </div>

                    <h1>Crear Cuenta</h1>

                    <div class="pf-pips">
                        <span class="pf-pip"></span>
                    </div>
                </header>

                <!-- MENSAJE DE ERROR -->
                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="pf-error" id="errorBox">
                        <span>⚠</span>
                        <span id="errorMessage">@mensajeError</span>
                    </div>
                }

                @if (cargando)
                {
                    <p class="pf-loading">⏳ Guardando granjero...</p>
                }
                else
                {
                    <div class="pf-body">
                        <div class="pf-field">
                            <label for="usernameInput">
                                <span>🏷</span>
                                <span>Usuario</span>
                            </label>
                            <div class="pf-input">
                                <input id="usernameInput"
                                       type="text"
                                       required
                                       autocomplete="username"
                                       placeholder="Nombre de usuario"
                                       @bind="registro.userName" />
                            </div>
                        </div>

                        <div class="pf-field">
                            <label for="emailInput">
                                <span>📧</span>
                                <span>Correo</span>
                            </label>
                            <div class="pf-input">
                                <input id="emailInput"
                                       type="email"
                                       required
                                       autocomplete="email"
                                       placeholder="Correo electrónico"
                                       @bind="registro.email" />
                            </div>
                        </div>

                        <div class="pf-field">
                            <label for="passwordInput">
                                <span>🔒</span>
                                <span>Contrase&ntilde;a</span>
                            </label>
                            <div class="pf-input">
                                <input id="passwordInput"
                                       type="password"
                                       required
                                       minlength="8"
                                       autocomplete="new-password"
                                       placeholder="Contraseña"
                                       @bind="registro.password" />
                            </div>
                        </div>

                        <div class="pf-actions">
                            <button type="submit" class="boton-primario">
                                <span>📝</span>
                                <span>Crear cuenta</span>
                            </button>

                            <button type="button"
                                    class="custom-btn volver"
                                    @onclick="Volver">
                                <span>⬅</span>
                                <span>Volver Al Login</span>
                            </button>
                        </div>
                    </div>

                    <!-- PIE -->
                    <footer class="pf-footer">
                        <span class="pf-footer-right">PP-FARM-OS</span>
                    </footer>
                }

            </form>
        </div>
    </div>
</div>

@code {
    private RegistroDTO registro = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;

    private async Task ProcesarRegistro()
    {
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/jugador/registrar", registro);

            if (response.IsSuccessStatusCode)
            {
                var sesion = await response.Content.ReadFromJsonAsync<SesionDTO>();
                registro.password = string.Empty;

                if (sesion != null)
                {
                    JugadorState.EstablecerJugador(sesion);
                    Navigation.NavigateTo("/");
                }
            }

            var errorApi = await response.Content.ReadAsStringAsync();
            mensajeError = !string.IsNullOrWhiteSpace(errorApi) ? errorApi : "No se pudo registrar el usuario.";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/login");
    }
}