@page "/"
@inject JugadorState jugadorState
@inject JugadorServicio jugadorServicio
@inject CatalogoRecursos catalogoRecursos
@inject NavigationManager navigationManager
<PageTitle>Home</PageTitle>

<div style="cursor: @cursorActual;" @onmousedown="CambiarAClick" @onmouseup="RestablecerAMain" @onmouseover="RestablecerAMain" @onmouseleave="RestablecerAMain"
     class="home-content">
    <div class="barra-lateral">
        <nav>
            <ul>
                <li>@(jugadorState?.__jugador?.userName ?? "Jugador")</li>
                <li>NIVEL @(jugadorState?.__jugador?.level ?? 0)</li>
                <li>XP @(jugadorState?.__jugador?.experiencia ?? 0) / @(jugadorState?.__jugador?.experienciaParaSubir ?? 10)</li>
                <li>PP @(jugadorState?.__jugador?.points ?? 0)</li>
                <li>PC @(jugadorState?.__jugador?.ppCoins ?? 0)</li>
                <li><CustomButton OnClick="IrATienda" Label="Tienda"></CustomButton></li>
                <li><CustomButton OnClick="IrAMochila" Label="Mochila"></CustomButton></li>
                <li><CustomButton onclick="IrAComputadora" Label="Computadora"></CustomButton></li>
                <li><CustomButton onclick="IrAConfiguracion" Label="Configuración"></CustomButton></li>
                <li><CustomButton OnClick="GuardarPartidaAsync" Label="@LabelGuardar" Color="#2e7d32"></CustomButton></li>
            </ul>
            @if (!string.IsNullOrEmpty(mensajeGuardado))
            {
                <p class="@ClaseMensajeGuardado">@mensajeGuardado</p>
            }
        </nav>
    </div>
    @if (recursos is not null)
    {
        <div class="game-container">
            <HuertaCeldasComponent></HuertaCeldasComponent>
            <div style="background-image: url(/images/ui/equipped-frame/EquippedItemFrame.png)" class="equipped-frame">
                <img src="/images/tools/@jugadorState.__jugador.recurso.nombre.ToLower().Replace(" ", "-")/Main.png" />
            </div>
        </div>
    }

    @if (mostrarTienda)
    {
    <TiendaModal OnClose="CerrarModales" />
    }

    @if (mostrarInventario)
    {
    <InventarioModal OnClose="CerrarModales" />
    }
    
</div>
@code {

    private bool mostrarTienda;
    private bool mostrarInventario;

    private string? mensajeGuardado;
    private bool exitoGuardado;
    private bool guardando;

    private string LabelGuardar => guardando ? "Guardando..." : "Guardar partida";
    private string ClaseMensajeGuardado => exitoGuardado ? "mensaje-guardado ok" : "mensaje-guardado error";

    public List<RecursoDTO>? recursos;
    string? cursorActual;
    string? currentToolImg;

    protected override async Task OnInitializedAsync()
    {
        if (jugadorState.__jugador is null)
        {
            navigationManager.NavigateTo("/login");
            return;
        }
        jugadorState.OnChange += Actualizar;
        jugadorState.__jugador.OnCambioUltimaHerramienta += SetUpTool;

        recursos = await catalogoRecursos.ObtenerRecursosAsync();

        SetUpTool();
    }

    //NAVEGACIÓN

    public void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }

    public void SetUpTool()
    {
        //obtener idUltimaHerramienta a partir de la lista de ITEMS del jugador.

        RecursoDTO dataHerramienta = recursos.Where(x => x.Id == jugadorState.__jugador.items.Where(i => i.idRecurso == x.Id).Select(i => i.idRecurso).FirstOrDefault()).FirstOrDefault() ??
        new RecursoDTO()
        {
            Id = 0,
            nombre = "Ninguna",
            descripcion = "No hay herramienta equipada",
            eficiencia = 10,
            durabilidad = -1,
            valor = 0,
            deTienda = false,
            tipo = PPFarmWA.Shared.Enum.TipoItemEnum.Herramienta,
            idRareza = PPFarmWA.Shared.Enum.RarezaEnum.Comun,
        };

        jugadorState.__jugador.recurso = dataHerramienta;
    }

    public void CambiarAClick()
    {
        cursorActual = $"url('/images/tools/default/Click.png'), auto";
    }

    public void RestablecerAMain()
    {
        cursorActual = $"url('/images/tools/default/Main.png'), auto";
    }


    //NAVEGACIÓN

    public void IrATienda()
    {
        mostrarInventario = false;
        mostrarTienda = true;
    }
    public void IrAMochila()
    {
        mostrarTienda = false;
        mostrarInventario = true;
    }

    private void CerrarModales()
    {
        mostrarTienda = false;
        mostrarInventario = false;
    }
    public void IrAComputadora()
    {
        navigationManager.NavigateTo("/internet");
    }
    public void IrAConfiguracion()
    {
        navigationManager.NavigateTo("/");
    }

    //GUARDAR PARTIDA

    public async Task GuardarPartidaAsync()
    {
        var jugador = jugadorState.__jugador;

        if (jugador is null)
        {
            exitoGuardado = false;
            mensajeGuardado = "No hay jugador en sesión.";
            return;
        }

        guardando = true;
        try
        {
            var (exito, mensaje) = await jugadorServicio.GuardarPartida(jugador);

            exitoGuardado = exito;
            mensajeGuardado = mensaje;
        }
        catch (Exception ex)
        {
            exitoGuardado = false;
            mensajeGuardado = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    public void Dispose()
    {
        jugadorState.OnChange -= Actualizar;
    }

    //se solucionaron los errores de q no aparecian las ventanas desplazantes de tienda y inventario
    //ahora tengo q comprobar por que me sale error cuando habro los modales sera por validaciones o por q el modal tiene algo raro en la parte del render.
    // por otra parte ya poner a prueba la bd y verificar q no haiga errores y q se carguen las cosas
    //correctamente.
}
