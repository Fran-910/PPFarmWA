@page "/"
@implements IDisposable

@inject JugadorState jugadorState
@inject JugadorServicio jugadorServicio
@inject CatalogoRecursos catalogoRecursos
@inject NavigationManager navigationManager

<PageTitle>Home</PageTitle>

@if (!mostrarInternet)
{
    <div style="cursor: @cursorActual;"
         @onmousedown="CambiarAClick"
         @onmouseup="RestablecerAMain"
         @onmouseover="RestablecerAMain"
         @onmouseleave="RestablecerAMain"
         class="home-content terrain-bg">

        <div class="barra-lateral">
            <nav>
                <ul>

                    <li class="jugador-nombre">
                        @(jugadorState?.__jugador?.userName ?? "Jugador")
                    </li>

                    <li class="jugador-nivel">
                        NIVEL @(jugadorState?.__jugador?.level ?? 0)
                    </li>

                    <li class="jugador-xp">
                        XP @(jugadorState?.__jugador?.experiencia ?? 0)
                        / @(jugadorState?.__jugador?.experienciaParaSubir ?? 10)
                    </li>

                    <li class="jugador-moneda">
                        <span class="coin coin-pp">PP</span>
                        <span class="coin-valor">
                            @(jugadorState?.__jugador?.points ?? 0)
                        </span>
                    </li>

                    <li class="jugador-moneda">
                        <span class="coin coin-pc">PC</span>
                        <span class="coin-valor">
                            @(jugadorState?.__jugador?.ppCoins ?? 0)
                        </span>
                    </li>

                    <li class="jugador-accion">
                        <CustomButton OnClick="IrATienda"
                                      Label="Tienda" />
                    </li>

                    <li class="jugador-accion">
                        <CustomButton OnClick="IrAMochila"
                                      Label="Mochila" />
                    </li>

                    <li class="jugador-accion">
                        <CustomButton OnClick="IrAComputadora"
                                      Label="Computadora" />
                    </li>

                    <li class="jugador-accion">
                        <CustomButton OnClick="IrAIntercambios"
                                      Label="Intercambios" />
                    </li>

                    <li class="jugador-accion">
                        <CustomButton OnClick="IrAConfiguracion"
                                      Label="Configuración" />
                    </li>

                    <li class="jugador-accion">
                        <CustomButton OnClick="GuardarPartidaAsync"
                                      Label="@LabelGuardar"
                                      Class="btn-guardar" />
                    </li>

                </ul>

                @if (!string.IsNullOrEmpty(mensajeGuardado))
                {
                    <p class="@ClaseMensajeGuardado">
                        @mensajeGuardado
                    </p>
                }
            </nav>
        </div>

        @if (recursos is not null)
        {
            <div class="game-container">

                <div class="game-header">
                    <span>PaginaPrincipal</span>
                    <span class="game-version">PPFarmWA v1.0</span>
                </div>

                <HuertaCeldasComponent />

                <div class="equipped-frame">
                    <img src="/images/tools/@jugadorState.__jugador.recurso.nombre.ToLower().Replace(" ", "-")/Main.png" />
                </div>

            </div>
        }

        @if (mostrarTienda)
        {
            <TiendaModal OnClose="CerrarModales" />
        }

        @if (mostrarInventario)
        {
            <InventarioModal OnClose="CerrarModales" />
        }

    </div>
}

@if (mostrarInternet)
{
    <Internet />
}

@code
{
    private bool mostrarTienda;
    private bool mostrarInventario;
    private bool mostrarInternet;

    private string? mensajeGuardado;
    private bool exitoGuardado;
    private bool guardando;
    private CancellationTokenSource? ctsMensaje;

    private string LabelGuardar =>
        guardando ? "Guardando..." : "Guardar partida";

    private string ClaseMensajeGuardado =>
        exitoGuardado
            ? "mensaje-guardado ok"
            : "mensaje-guardado error";

    public List<RecursoDTO>? recursos;

    string? cursorActual;
    string? currentToolImg;

    protected override async Task OnInitializedAsync()
    {
        if (jugadorState.__jugador is null)
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        jugadorState.OnChange += Actualizar;
        jugadorState.__jugador.OnCambioUltimaHerramienta += SetUpTool;

        recursos = await catalogoRecursos.ObtenerRecursosAsync();

        SetUpTool();
    }

    public void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }

    public void SetUpTool()
    {
        RecursoDTO dataHerramienta =
            recursos.Where(x =>
                x.Id ==
                jugadorState.__jugador.items
                    .Where(i => i.idRecurso == x.Id)
                    .Select(i => i.idRecurso)
                    .FirstOrDefault())
            .FirstOrDefault()
            ??
            new RecursoDTO()
            {
                Id = 0,
                nombre = "Ninguna",
                descripcion = "No hay herramienta equipada",
                eficiencia = 10,
                durabilidad = -1,
                valor = 0,
                deTienda = false,
                tipo = PPFarmWA.Shared.Enum.TipoItemEnum.Herramienta,
                idRareza = PPFarmWA.Shared.Enum.RarezaEnum.Comun
            };

        jugadorState.__jugador.recurso = dataHerramienta;
    }

    public void CambiarAClick()
    {
        cursorActual =
            "url('/images/tools/default/Click.png'), auto";
    }

    public void RestablecerAMain()
    {
        cursorActual =
            "url('/images/tools/default/Main.png'), auto";
    }

    public void IrATienda()
    {
        mostrarInventario = false;
        mostrarTienda = true;
    }

    public void IrAMochila()
    {
        mostrarTienda = false;
        mostrarInventario = true;
    }

    private void CerrarModales()
    {
        mostrarTienda = false;
        mostrarInventario = false;
    }

    public void IrAComputadora()
    {
        mostrarInternet = true;
    }

    public void IrAIntercambios()
    {
        navigationManager.NavigateTo("/intercambios");
    }

    public void IrAConfiguracion()
    {
        navigationManager.NavigateTo("/");
    }

    public async Task GuardarPartidaAsync()
    {
        var jugador = jugadorState.__jugador;

        if (jugador is null)
        {
            await MostrarMensajeTemporal(
                "No hay jugador en sesión.",
                false);
            return;
        }

        guardando = true;

        try
        {
            var (exito, mensaje) =
                await jugadorServicio.GuardarPartida(jugador);

            await MostrarMensajeTemporal(mensaje, exito);
        }
        catch (Exception ex)
        {
            await MostrarMensajeTemporal(
                $"Error de conexión: {ex.Message}",
                false);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task MostrarMensajeTemporal(
        string mensaje,
        bool exito,
        int milisegundos = 3000)
    {
        ctsMensaje?.Cancel();
        ctsMensaje?.Dispose();

        ctsMensaje = new CancellationTokenSource();

        var token = ctsMensaje.Token;

        exitoGuardado = exito;
        mensajeGuardado = mensaje;

        try
        {
            await Task.Delay(milisegundos, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested)
        {
            return;
        }

        mensajeGuardado = null;

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ctsMensaje?.Cancel();
        ctsMensaje?.Dispose();

        jugadorState.OnChange -= Actualizar;
    }
}