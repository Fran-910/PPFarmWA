@page "/"
@inject JugadorState jugadorState
@inject CatalogoRecursos catalogoRecursos
@inject NavigationManager navigationManager
<PageTitle>Home</PageTitle>

<div style="cursor: @cursorActual;" @onmousedown="CambiarAClick" @onmouseup="RestablecerAMain" @onmouseover="RestablecerAMain" @onmouseleave="RestablecerAMain"
     class="home-content">
    <div class="barra-lateral">
        <nav>
            <ul>
                <li>PEPE</li>
                <li>NIVEL @(jugadorState?.__jugador?.level ?? 0)</li>
                <li>XP @(jugadorState?.__jugador?.experiencia ?? 0) / @(jugadorState?.__jugador?.experienciaParaSubir ?? 10)</li>
                <li>PP @(jugadorState?.__jugador?.points ?? 0)</li>
                <li>PC @(jugadorState?.__jugador?.ppCoins ?? 0)</li>
                <li><CustomButton onclick="IrATienda" Label="Tienda"></CustomButton></li>
                <li><CustomButton onclick="IrAMochila" Label="Mochila"></CustomButton></li>
                <li><CustomButton onclick="IrAComputadora" Label="Computadora"></CustomButton></li>
                <li><CustomButton onclick="IrAConfiguracion" Label="Configuración"></CustomButton></li>
            </ul>
        </nav>
    </div>
    @if (recursos is not null)
    {
        <div class="game-container">
            <HuertaCeldasComponent></HuertaCeldasComponent>
            <div style="background-image: " class="equipped-frame">
                <img src="/images/ui/equipped-frame/EquippedItemFrame.png" />
                <div>
                </div>
            </div>
        </div>
    }
    else
    {
        //LOADING
    }
    @code {
    public Jugador jugador;
    public List<RecursoDTO> recursos;
    string cursorActual;
    string currentToolImg;

    protected override async Task OnInitializedAsync()
    {
        jugador = new Jugador()
        {
            Id = 20,
            experiencia = 0,
            level = 1,
            points = 10,
            ppCoins = 10,
            idUltimaHerramienta = 1,
        };

        jugadorState.EstablecerJugador(jugador);

        jugadorState.OnChange += Actualizar;
        jugador.OnCambioUltimaHerramienta += SetUpTool;

        recursos = await catalogoRecursos.ObtenerRecursosAsync();

        SetUpTool();
    }

    public void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }

    public void SetUpTool()
    {
        RecursoDTO dataHerramienta = recursos.Where(x => x.Id == jugadorState.__jugador.idUltimoRecurso).FirstOrDefault() ??
        new RecursoDTO()
        {
            Id = 0,
            nombre = "Ninguna",
            descripcion = "No hay herramienta equipada",
            eficiencia = 10,
            durabilidad = 10,
            valor = 0,
            deTienda = false,
            tipo = PPFarmWA.Shared.Enum.TipoItemEnum.Herramienta,
            idRareza = PPFarmWA.Shared.Enum.RarezaEnum.Comun,
        };

        jugadorState.__jugador.recurso = dataHerramienta;
    }

    public void CambiarAClick()
    {
        cursorActual = $"url('/images/tools/default/Click.png'), auto";
    }

    public void RestablecerAMain()
    {
        cursorActual = $"url('/images/tools/default/Main.png'), auto";
    }


    //NAVEGACIÓN

    public void IrATienda()
    {
        navigationManager.NavigateTo("/tienda");
    }
    public void IrAMochila()
    {
        navigationManager.NavigateTo("/inventario");
    }
    public void IrAComputadora()
    {
        navigationManager.NavigateTo("/internet");
    }
    public void IrAConfiguracion()
    {
        navigationManager.NavigateTo("/");
    }
}
