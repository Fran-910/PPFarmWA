@page "/intercambios"
@inject VentaServicio VentaServicio
@inject ItemServicio ItemServicio
@inject JugadorState JugadorState
@inject NavigationManager NavigationManager

<PageTitle>Mercado de Intercambios - PPFarmWA</PageTitle>

<div class="intercambios-game">
    <header class="top-bar">
        <button class="btn-pixel-wood btn-volver" @onclick="VolverAlHome">
            <svg class="icon-arrow" viewBox="0 0 24 24">
                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"></path>
            </svg>
            <span>Volver</span>
        </button>

        <div class="active-offers-panel">
            <div class="active-offers-item">
                <div class="stat-icon">📦</div>
                <div class="stat-info">
                    <span class="stat-label">Ofertas activas</span>
                    <span class="stat-value">@ventasDisponibles.Count</span>
                </div>
            </div>
        </div>
    </header>

    <div class="market-title-sign">
        <div class="corner-leaf tl"></div>
        <div class="corner-leaf br"></div>

        <div class="stall-icon">
            <div class="stall-awning">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="stall-crate">🧺</div>
        </div>

        <div class="market-title-text">
            <h1>MERCADO DE INTERCAMBIOS</h1>
            <p>Compra y vende recursos con otros jugadores de PPFarmWA</p>
        </div>
    </div>

    <main class="market-layout">
        <section class="publish-panel">
            <div class="corner-leaf tl"></div>
            <div class="corner-leaf br"></div>

            <div class="panel-header">
                <div class="panel-header-icon">🏪</div>
                <div>
                    <h2>PUBLICAR INTERCAMBIO</h2>
                    <p>Selecciona un recurso de tu inventario y establece la cantidad y el precio.</p>
                </div>
            </div>

            <div class="inner-parchment">
                <div class="form-row">
                    <div class="form-group full">
                        <div class="label-row">
                            <label>Recurso</label>
                            <div class="inventory-badge">
                                <span>🎒</span>
                                <span>Inventario:</span>
                                <span class="inventory-count">@inventarioAgrupado.Sum(x => x.cantidadTotal)</span>
                            </div>
                        </div>

                        <div class="select-wrapper">
                            <span class="select-icon">@IconoRecurso(itemSeleccionadoId == 0 ? "" : (inventarioAgrupado.FirstOrDefault(x => x.IdRepresentativo == itemSeleccionadoId)?.nombre ?? ""))</span>

                            <select class="pixel-select" @bind="itemSeleccionadoId">
                                <option value="0">Seleccionar recurso</option>
                                @foreach (var item in inventarioAgrupado.Where(x => x.cantidadTotal > 0))
                                {
                                    <option value="@item.IdRepresentativo">
                                        @IconoRecurso(item.nombre) @item.nombre - Cantidad: @item.cantidadTotal
                                    </option>
                                }
                            </select>

                            <span class="select-chevron">▼</span>
                        </div>
                    </div>
                </div>

                <div class="inventory-integrated">
                    <div class="inventory-integrated-header">
                        <span class="inventory-integrated-title">MI INVENTARIO DISPONIBLE</span>
                    </div>

                    <div class="inventory-list inventory-list-integrated">
                        @if (inventarioAgrupado.Count == 0)
                        {
                            <div class="inventory-empty">No tienes recursos en inventario.</div>
                        }
                        else
                        {
                            @foreach (var inv in inventarioAgrupado.Where(x => x.cantidadTotal > 0))
                            {
                                <button type="button"
                                        class="inventory-item inventory-item-integrated @(itemSeleccionadoId == inv.IdRepresentativo ? "selected" : "")"
                                        @onclick="() => SeleccionarRecursoInventario(inv.IdRepresentativo)">
                                    <div class="inventory-item-icon">@IconoRecurso(inv.nombre)</div>
                                    <div class="inventory-item-info">
                                        <div class="inventory-item-name">@inv.nombre</div>
                                        <div class="inventory-item-qty">x @inv.cantidadTotal</div>
                                    </div>
                                </button>
                            }
                        }
                    </div>
                </div>

                <div class="form-row two">
                    <div class="form-group">
                        <label>Cantidad a vender</label>
                        <input type="number" class="pixel-input" min="1" @bind="cantidadVenta" />
                    </div>

                    <div class="form-group">
                        <label>Precio (PP Coins)</label>
                        <div class="input-with-icon">
                            <span class="input-icon">🪙</span>
                            <input type="number" class="pixel-input has-icon" min="0" @bind="precioVenta" />
                        </div>
                    </div>
                </div>

                <button class="btn-pixel-green btn-publish" @onclick="PublicarIntercambio">
                    <span>🛒</span>
                    <span>PUBLICAR INTERCAMBIO</span>
                </button>

                @if (!string.IsNullOrWhiteSpace(mensajePublicacion))
                {
                    <div class="form-message">@mensajePublicacion</div>
                }
            </div>
        </section>

        <section class="offers-panel">
            <div class="corner-leaf tl"></div>
            <div class="corner-leaf br"></div>

            <div class="offers-header">
                <div class="offers-title">
                    <div class="offers-title-icon">💎</div>
                    <div>
                        <h2>OFERTAS DISPONIBLES</h2>
                        <p>Intercambios publicados por otros jugadores.</p>
                    </div>
                </div>
            </div>

            <div class="offers-grid">
                @if (cargando)
                {
                    <div class="offers-empty">Cargando intercambios...</div>
                }
                else if (error)
                {
                    <div class="offers-empty">Ocurrió un error al cargar los intercambios.</div>
                }
                else if (ventasDisponibles.Count == 0)
                {
                    <div class="offers-empty">No hay intercambios disponibles.</div>
                }
                else
                {
                    @foreach (var venta in ventasDisponibles)
                    {
                        <article class="offer-card @GetCardClass(venta.nombreRecurso ?? "")">
                            <div class="offer-card-top">
                                <div class="offer-icon">@IconoRecurso(venta.nombreRecurso ?? "")</div>

                                <div class="offer-info">
                                    <div class="offer-name">@(venta.nombreRecurso ?? "Recurso")</div>
                                    <div class="offer-seller">
                                        Vendedor:
                                        <b>@(string.IsNullOrWhiteSpace(venta.nombreJugadorVendedor) ? $"Jugador {venta.idJugadorVendedor}" : venta.nombreJugadorVendedor)</b>
                                    </div>
                                    <div class="offer-qty">
                                        Cantidad: <b>@venta.cantidadVenta</b>
                                    </div>
                                </div>
                            </div>

                            <div class="offer-card-bottom">
                                <div class="offer-price">
                                    <span>🪙</span>
                                    <span>@venta.precioVenta PP</span>
                                </div>

                                <button class="btn-pixel-green btn-buy" @onclick="() => PrepararCompra(venta)">
                                    <span>🛒</span>
                                    <span>COMPRAR</span>
                                </button>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>
    </main>

    @if (mostrarConfirmacion && ventaSeleccionada != null)
    {
        <div class="modal-backdrop">
            <div class="modal-panel">
                <div class="corner-leaf tl"></div>
                <div class="corner-leaf br"></div>

                <div class="modal-header">
                    <div class="modal-header-icon">✅</div>
                    <h3>CONFIRMAR COMPRA</h3>
                </div>

                <div class="modal-body">
                    <div class="modal-row">
                        <span class="modal-label">Recurso</span>
                        <span class="modal-value">
                            @IconoRecurso(ventaSeleccionada.nombreRecurso ?? "")
                            @(ventaSeleccionada.nombreRecurso ?? "")
                        </span>
                    </div>

                    <div class="modal-row">
                        <span class="modal-label">Cantidad</span>
                        <span class="modal-value">@ventaSeleccionada.cantidadVenta</span>
                    </div>

                    <div class="modal-row">
                        <span class="modal-label">Precio</span>
                        <span class="modal-value">🪙 @ventaSeleccionada.precioVenta PP</span>
                    </div>

                    <div class="modal-row">
                        <span class="modal-label">Vendedor</span>
                        <span class="modal-value">
                            @(string.IsNullOrWhiteSpace(ventaSeleccionada.nombreJugadorVendedor)
                                ? $"Jugador {ventaSeleccionada.idJugadorVendedor}"
                                : ventaSeleccionada.nombreJugadorVendedor)
                        </span>
                    </div>
                </div>

                <div class="modal-actions">
                    <button class="btn-pixel-wood btn-modal" @onclick="CancelarCompra">
                        Cancelar
                    </button>

                    <button class="btn-pixel-green btn-modal" @onclick="ConfirmarCompra">
                        <span>🛒</span>
                        <span>Comprar</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string IconoRecurso(string nombre)
    {
        return nombre switch
        {
            "Pala" => "🪏",
            "Pico" => "⛏️",
            "Pala de Oro" => "🪏",
            _ => "📦"
        };
    }
    private string GetCardClass(string nombre)
    {
        return nombre switch
        {
            "Madera" => "card-wood",
            "Piedra" => "card-stone",
            "Hierro" => "card-tool",
            "Semillas" => "card-crop",
            "Trigo" => "card-crop",
            "Maíz" => "card-crop",
            "Zanahorias" => "card-crop",
            "Patata" => "card-crop",
            "Papa" => "card-crop",
            "Pala" => "card-tool",
            "Pico de Bronce" => "card-tool",
            "Pico de Diamante" => "card-tool",
            "Hoz Dorada" => "card-tool",
            _ => "card-wood"
        };
    }

    private void VolverAlHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private List<VentaDTO> ventasDisponibles = new();
    private List<InventarioDTO> inventarioJugador = new();
    private List<InventarioAgrupado> inventarioAgrupado = new();

    private int itemSeleccionadoId;
    private int cantidadVenta;
    private double precioVenta;
    private string mensajePublicacion = "";

    private bool mostrarConfirmacion = false;
    private VentaDTO? ventaSeleccionada;
    private bool cargando = true;
    private bool error = false;

    private class InventarioAgrupado
    {
        public int IdRepresentativo { get; set; }
        public int idRecurso { get; set; }
        public string nombre { get; set; } = string.Empty;
        public int cantidadTotal { get; set; }
    }

    private void ActualizarInventarioAgrupado()
    {
        inventarioAgrupado = inventarioJugador
            .Where(x => !string.IsNullOrWhiteSpace(x.nombre))
            .GroupBy(x => x.idRecurso)
            .Select(g =>
            {
                var primero = g.First();

                return new InventarioAgrupado
                {
                    IdRepresentativo = primero.Id,
                    idRecurso = g.Key,
                    nombre = primero.nombre,
                    cantidadTotal = g.Sum(x => x.cantidad)
                };
            })
            .OrderBy(x => x.nombre)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        if (JugadorState.__jugador == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        int jugadorId = JugadorState.__jugador.Id;

        try
        {
            ventasDisponibles = await VentaServicio.ObtenerDisponibles(jugadorId);
            inventarioJugador = await ItemServicio.ObtenerInventario(jugadorId);
            ActualizarInventarioAgrupado();
        }
        catch
        {
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task PublicarIntercambio()
    {
        mensajePublicacion = "";

        if (itemSeleccionadoId == 0)
        {
            mensajePublicacion = "Seleccioná un recurso.";
            return;
        }

        if (cantidadVenta <= 0)
        {
            mensajePublicacion = "Ingresá una cantidad válida.";
            return;
        }

        if (precioVenta < 0)
        {
            mensajePublicacion = "Ingresá un precio válido.";
            return;
        }

        if (JugadorState.__jugador == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        int jugadorId = JugadorState.__jugador.Id;

        var venta = new VentaDTO
        {
            idJugadorVendedor = jugadorId,
            idJugadorComprador = null,
            cantidadVenta = cantidadVenta,
            precioVenta = precioVenta
        };

        var creada = await VentaServicio.PublicarIntercambio(
            itemSeleccionadoId,
            venta);

        if (creada)
        {
            mensajePublicacion = "Intercambio publicado correctamente.";

            ventasDisponibles = await VentaServicio.ObtenerDisponibles(jugadorId);

            inventarioJugador = await ItemServicio.ObtenerInventario(jugadorId);
            ActualizarInventarioAgrupado();

            itemSeleccionadoId = 0;
            cantidadVenta = 0;
            precioVenta = 0;
        }
        else
        {
            mensajePublicacion = "No se pudo publicar el intercambio.";
        }
    }

    private void PrepararCompra(VentaDTO venta)
    {
        ventaSeleccionada = venta;
        mostrarConfirmacion = true;
    }

    private void SeleccionarRecursoInventario(int itemId)
    {
        itemSeleccionadoId = itemId;
    }

    private void CancelarCompra()
    {
        ventaSeleccionada = null;
        mostrarConfirmacion = false;
    }

    private async Task ConfirmarCompra()
    {
        if (JugadorState.__jugador == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        int jugadorId = JugadorState.__jugador.Id;

        if (ventaSeleccionada == null)
        {
            return;
        }

        var comprado = await VentaServicio.ComprarIntercambio(
            ventaSeleccionada.Id,
            jugadorId);

        mostrarConfirmacion = false;

        if (comprado)
        {
            mensajePublicacion = "Compra realizada correctamente.";
            ventasDisponibles = await VentaServicio.ObtenerDisponibles(jugadorId);
            inventarioJugador = await ItemServicio.ObtenerInventario(jugadorId);
            ActualizarInventarioAgrupado();
        }
        else
        {
            mensajePublicacion = "No se pudo realizar la compra.";
        }

        ventaSeleccionada = null;
    }

    private async Task ComprarIntercambio(int idVenta)
    {
        if (JugadorState.__jugador == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        int jugadorId = JugadorState.__jugador.Id;

        var comprado = await VentaServicio.ComprarIntercambio(
            idVenta,
            jugadorId);

        if (comprado)
        {
            mensajePublicacion = "Compra realizada correctamente.";
            ventasDisponibles = await VentaServicio.ObtenerDisponibles(jugadorId);
            inventarioJugador = await ItemServicio.ObtenerInventario(jugadorId);
            ActualizarInventarioAgrupado();
        }
        else
        {
            mensajePublicacion = "No se pudo realizar la compra.";
        }
    }
}