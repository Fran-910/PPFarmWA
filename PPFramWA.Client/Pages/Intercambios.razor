@page "/intercambios"
@inject VentaServicio VentaServicio
@inject ItemServicio ItemServicio
@inject JugadorState JugadorState
@inject NavigationManager NavigationManager

<PageTitle>Intercambios</PageTitle>

<button class="btn-volver" @onclick="VolverAlHome">
    ← Volver
</button>
<div class="intercambios">

    <h1>Intercambios</h1>

    <!-- PUBLICAR INTERCAMBIO -->
    <div class="publicar">

        <h2>Publicar intercambio</h2>

        <div class="campo">
            <label>Recurso</label>

            <select @bind="itemSeleccionadoId">
                <option value="">Seleccionar recurso</option>

                @foreach (var item in inventarioJugador)
                {
                    <option value="@item.Id">
                        @IconoRecurso(item.nombre) @item.nombre - Cantidad: @item.cantidad
                    </option>
                }
            </select>
        </div>

        <div class="campo">
            <label>Cantidad</label>

            <input type="number"
                   min="1"
                   @bind="cantidadVenta"
                   placeholder="Cantidad" />
        </div>

        <div class="campo">
            <label>Precio</label>

            <input type="number"
                   min="0"
                   @bind="precioVenta"
                   placeholder="PP Coins" />
        </div>

        <button class="btn-publicar" @onclick="PublicarIntercambio">
            Publicar intercambio
        </button>

        @if (!string.IsNullOrWhiteSpace(mensajePublicacion))
        {
            <p>@mensajePublicacion</p>
        }

    </div>
    <!-- INTERCAMBIOS DISPONIBLES -->
    <div class="disponibles">

        <h2>Intercambios disponibles</h2>

        <div class="lista-intercambios">

            @if (cargando)
            {
                <p>Cargando intercambios...</p>
            }
            else if (error)
            {
                <p>Ocurrió un error al cargar los intercambios.</p>
            }
            else if (ventasDisponibles.Count == 0)
            {
                <p>No hay intercambios disponibles.</p>
            }
            else
            {
                @foreach (var venta in ventasDisponibles)
                {
                    <div class="intercambio">

                        <h3>👤 Jugador @venta.idJugadorVendedor</h3>

                        <p class="recurso-venta">
                            @IconoRecurso(venta.nombreRecurso ?? "") @venta.nombreRecurso
                        </p>

                        <p>
                            <strong>Cantidad:</strong>
                            @venta.cantidadVenta
                        </p>

                        <p>
                            <strong>Precio:</strong>
                            🪙 @venta.precioVenta PP Coins
                        </p>

                        <button class="btn-comprar"
                                @onclick="() => PrepararCompra(venta)">
                            🛒 Comprar
                        </button>

                    </div>
                }
            }

        </div>

    </div>

    @if (mostrarConfirmacion && ventaSeleccionada != null)
    {
        <div class="modal-fondo">

            <div class="modal-compra">

                <h2>Confirmar compra</h2>
                <p class="recurso-venta">
                    @IconoRecurso(ventaSeleccionada.nombreRecurso ?? "") @ventaSeleccionada.nombreRecurso
                </p>

                <p>
                    <strong>Cantidad:</strong>
                    @ventaSeleccionada.cantidadVenta
                </p>

                <p>
                    <strong>Precio:</strong>
                    🪙 @ventaSeleccionada.precioVenta PP Coins
                </p>

                <p>
                    <strong>Vendedor:</strong>
                    Jugador @ventaSeleccionada.idJugadorVendedor
                </p>

                <div class="modal-botones">

                    <button class="btn-cancelar"
                            @onclick="CancelarCompra">
                        Cancelar
                    </button>

                    <button class="btn-confirmar"
                            @onclick="ConfirmarCompra">
                        Comprar
                    </button>

                </div>

            </div>

        </div>
    }

</div>





@code {

    private string IconoRecurso(string nombre)
    {
        return nombre switch
        {
            "Pala" => "🪏",
            "Madera" => "🪵",
            "Hierro" => "⚙️",
            "Pico de Hierro" => "⛏️",
            "Semillas" => "🌱",
            _ => "📦"
        };
    }

    private void VolverAlHome()
{
    NavigationManager.NavigateTo("/");
}
    private List<VentaDTO> ventasDisponibles = new();
    private List<InventarioDTO> inventarioJugador = new();
    private int itemSeleccionadoId;
    private int cantidadVenta;
    private double precioVenta;
    private string mensajePublicacion = "";
    private bool mostrarConfirmacion = false;
    private VentaDTO? ventaSeleccionada;

    private bool cargando = true;
    private bool error = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ventasDisponibles = await VentaServicio.ObtenerDisponibles();

            int jugadorId = JugadorState.__jugador?.Id ?? 20;

            inventarioJugador = await ItemServicio.ObtenerInventario(jugadorId);
        }
        catch
        {
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task PublicarIntercambio()
    {
        mensajePublicacion = "";

        if (itemSeleccionadoId == 0)
        {
            mensajePublicacion = "Seleccioná un recurso.";
            return;
        }

        if (cantidadVenta <= 0)
        {
            mensajePublicacion = "Ingresá una cantidad válida.";
            return;
        }

        if (precioVenta < 0)
        {
            mensajePublicacion = "Ingresá un precio válido.";
            return;
        }

        int jugadorId = JugadorState.__jugador?.Id ?? 20;

        var venta = new VentaDTO
        {
            idJugadorVendedor = jugadorId,
            idJugadorComprador = null,
            cantidadVenta = cantidadVenta,
            precioVenta = precioVenta
        };

        var creada = await VentaServicio.PublicarIntercambio(
            itemSeleccionadoId,
            venta);

        if (creada)
        {
            mensajePublicacion = "Intercambio publicado correctamente.";
            ventasDisponibles = await VentaServicio.ObtenerDisponibles();
            inventarioJugador = await ItemServicio.ObtenerInventario(jugadorId);
        }
        else
        {
            mensajePublicacion = "No se pudo publicar el intercambio.";
        }
    }





    private void PrepararCompra(VentaDTO venta)
    {
        ventaSeleccionada = venta;
        mostrarConfirmacion = true;
    }

    private void CancelarCompra()
    {
        ventaSeleccionada = null;
        mostrarConfirmacion = false;
    }

    private async Task ConfirmarCompra()
    {
        if (ventaSeleccionada == null)
            return;

       int jugadorId = JugadorState.__jugador?.Id ?? 0;
        var comprado = await VentaServicio.ComprarIntercambio(
            ventaSeleccionada.Id,
            jugadorId
        );

        mostrarConfirmacion = false;

        if (comprado)
        {
            mensajePublicacion = "Compra realizada correctamente.";

            ventasDisponibles = await VentaServicio.ObtenerDisponibles();
            inventarioJugador = await ItemServicio.ObtenerInventario(jugadorId);
        }
        else
        {
            mensajePublicacion = "No se pudo realizar la compra.";
        }

        ventaSeleccionada = null;
    }

    private async Task ComprarIntercambio(int idVenta)
    {
       int jugadorId = JugadorState.__jugador?.Id ?? 0;
        var comprado = await VentaServicio.ComprarIntercambio(
            idVenta,
            jugadorId
        );

        if (comprado)
        {
            mensajePublicacion = "Compra realizada correctamente.";

            ventasDisponibles = await VentaServicio.ObtenerDisponibles();

            inventarioJugador = await ItemServicio.ObtenerInventario(jugadorId);
        }
        else
        {
            mensajePublicacion = "No se pudo realizar la compra.";
        }
    }



}
