<button class="custom-btn @Class" style="@ButtonStyle" @onclick="HandleClick">
    @Label
</button>
@code {
    [Parameter]
    public string Label { get; set; } = "Botón";

    // Acepta valores CSS: hex, nombres, rgb(), variables CSS...
    // Si se deja vacio no se aplica color inline y manda el fondo de .custom-btn.
    [Parameter]
    public string Color { get; set; } = string.Empty;

    // Clases adicionales del diseno (por ejemplo "btn-guardar").
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string ButtonStyle => string.IsNullOrWhiteSpace(Color)
        ? string.Empty
        : $"background-color: {Color};";

    private Task HandleClick(MouseEventArgs e) => OnClick.InvokeAsync(e);
}