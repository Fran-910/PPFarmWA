<button class="custom-btn" style="@ButtonStyle" @onclick="HandleClick">
    @Label
</button>
@code {
    [Parameter]
    public string Label { get; set; } = "Botón";

    // Acepta valores CSS: hex, nombres, rgb(), variables CSS...
    [Parameter]
    public string Color { get; set; } = "#0d6efd";

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string ButtonStyle => $"background-color: {Color}; border: none; color: white; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer;";

    private Task HandleClick(MouseEventArgs e) => OnClick.InvokeAsync(e);
}
