@inject JugadorState jugadorState
@implements IDisposable

<div class="huerta-container" style="--celdas: @huerta!.columnas">
    <div class="pixel-wood-fence">

        <!-- Cuadricula completa: --celdas es divisor de cantCeldas (ver CeldasHuerta) -->
        <div class="huerta-grid" id="huertaGrid">
            @for (int i = 1; i <= huerta!.cantCeldas; i++)
            {
                <div class="huerta-celda">
                    <CultivoComponent></CultivoComponent>
                </div>
            }
        </div>

    </div>
</div>

@code {
    public Huerta? huerta { get; set; }
    private Jugador? jugadorSuscrito;

    protected override void OnInitialized()
    {
        huerta = new Huerta(jugadorState);
        jugadorSuscrito = jugadorState.__jugador;
        jugadorSuscrito!.OnSubioNivel += ActualizarCeldas;
    }

    public void ActualizarCeldas()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (jugadorSuscrito is not null)
            jugadorSuscrito.OnSubioNivel -= ActualizarCeldas;

        huerta?.Dispose();
    }
}